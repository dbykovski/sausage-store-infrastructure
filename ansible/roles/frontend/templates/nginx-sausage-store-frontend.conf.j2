server {
        listen 80 default_server;
        listen [::]:80 default_server;

        root /var/www-data/frontend/dist/frontend/;

        index index.html;

        server_name _;

        location / {
                try_files $uri $uri/ /index.html;
        }
        location /api/ {
                proxy_pass http://127.0.0.1:8080;
        }
}